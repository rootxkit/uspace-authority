# Build and test output
/bin/
/dist/
*.test
*.out
coverage.*
bench.txt
integration.log
vectors.log
scenarios.log
/scenario-results/

# Local data that must never be committed (spec 06 §4): geoid grids,
# DEM tiles, keys, certificates, environment files.
/local/
*.pgm
# except the small synthetic ones internal/ground's tests generate
!/internal/ground/testdata/**/*.pgm
*.tif
*.tiff
*.pem
*.key
*.crt
.env
.env.*
!.env.example

# Web (WP-21)
web/node_modules/
web/.next/
web/coverage/
web/next-env.d.ts
web/*.tsbuildinfo
web/test-results/
web/playwright-report/
web/*.log

# Editors and OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# Tooling caches
/.golangci-cache/
/.staticcheck/
