# Every variable rid-ingest reads, generated by scripts/gen-env-catalog.sh
# from its --help; do not edit. Defaults apply when a variable is unset;
# (required) ones have none, (secret) ones belong in AUTHORITY_SECRETS_DIR.
#

# minimum level of the JSON log on stdout (default info; one of debug, info, warn, error)
#LOG_LEVEL=info

# listen address of /healthz, /readyz and /metrics; private network only, never routed by Caddy (default :9090)
#ADMIN_ADDR=:9090

# seconds between status lines carrying every counter (E-09) (default 60)
#STATUS_INTERVAL_S=60

# bound on the drain after SIGTERM; the process exits non-zero when it is exceeded (default 15)
#SHUTDOWN_TIMEOUT_S=15

# OTLP/HTTP trace endpoint; tracing is a no-op when unset
#OTEL_EXPORTER_OTLP_ENDPOINT=

# this process's NATS credentials file (.creds); per-process credentials (plan §6); empty in the development stack
#NATS_CREDS=

# connection attempts at start before the process starts degraded and keeps connecting in the background (B-08) (default 3)
#NATS_START_ATTEMPTS=3

# wait after the first failed attempt at start; doubled after each (default 500)
#NATS_START_BACKOFF_MS=500

# bound on one connection attempt and on one KV read or write of the source-control state (default 2000)
#NATS_TIMEOUT_MS=2000

# storage of the TRK stream (the 1 h track mirror) (default file; one of file, memory)
#BUS_TRK_STORAGE=file

# hard bound of the INGEST work queue (discard new: a receiver is told 503); twice rid-ingest's shedding bound plus its batches in flight (default 120512)
#BUS_INGEST_MAX_MSGS=120512

# KV bucket of the source-control state (one key, the whole state) (default source_control)
#SOURCE_CONTROL_BUCKET=source_control

# push subject of every source-control state (default ctl.sources)
#SOURCE_CONTROL_SUBJECT=ctl.sources

# largest source-control state the bucket holds; a switch that would exceed it is refused naming the limit (E-10) (default 262144)
#SOURCE_CONTROL_MAX_VALUE_BYTES=262144

# seconds between re-reads of the source-control state by every follower, besides the watch and the push (default 5)
#SOURCE_CONTROL_REREAD_S=5

# default request body cap; routes may override it (default 1048576)
#HTTP_MAX_BODY_BYTES=1048576

# time allowed to read request headers (default 5)
#HTTP_READ_HEADER_TIMEOUT_S=5

# sustained requests per second per client (default 20)
#HTTP_RATE_LIMIT_RPS=20

# burst size per client (default 40)
#HTTP_RATE_LIMIT_BURST=40

# clients tracked by the rate limiter; the least recently seen is evicted beyond it (default 10000)
#HTTP_RATE_LIMIT_MAX_CLIENTS=10000

# CIDRs or addresses of the reverse proxies (Caddy) whose X-Forwarded-For names the client; the rightmost hop that is not one of them is the client address of every limiter and audit row
#AUTHORITY_TRUSTED_PROXIES=

# public listen address of /v1/rid/observations (behind Caddy); used with or without receiver keys: with none every batch is refused and /readyz says so (default :8081)
#RID_INGEST_ADDR=:8081

# telemetry database (projections, read only) (required; secret)
#TS_URL=

# NATS JetStream (required; secret)
#NATS_URL=

# GeographicLib geoid grid (egm2008-2_5.pgm, fetched by deploy/fetch-ground.sh); unset: no AMSL altitude from HAE, said at start and on every status line (R-07)
#GEOID_FILE=

# work-queue depth beyond which the oldest undelivered batch is shed with a writer_gaps record (05 §5); about 10 min of 50 receivers posting every second, doubled (default 60000)
#RID_INGEST_QUEUE_MAX_BATCHES=60000

# a queued batch older than this is shed with a writer_gaps record (the 10-minute bound of ingest.v1) (default 600)
#RID_INGEST_QUEUE_MAX_AGE_S=600

# batches delivered to this process and not yet settled (default 256)
#RID_INGEST_QUEUE_MAX_ACK_PENDING=256

# delay before a batch whose rows were not handed to tsdb-writer is delivered again (default 1000)
#RID_INGEST_STORAGE_RETRY_MS=1000

# nonces remembered per receiver key generation (core auth.WithNonceMemory); beyond it the oldest is forgotten and counted (nonces_evicted) (default 4096)
#RID_INGEST_NONCE_MEMORY=4096

# window per receiver in which an observation (transmitter, rx_ts, payload hash) is queued once (B-05) (default 60)
#RID_INGEST_DEDUPE_WINDOW_S=60

# observations remembered per receiver in the dedupe window; beyond it the oldest is forgotten and counted (default 20000)
#RID_INGEST_DEDUPE_MAX_PER_RECEIVER=20000

# receivers whose dedupe window and status counters are kept (E-10) (default 10000)
#RID_INGEST_MAX_RECEIVERS=10000

# seconds between full re-reads of the key set besides the KV watch (default 60)
#RID_INGEST_KEYSET_REREAD_S=60

# interval of src.v1.direct_rid.<receiver> status messages (04 §3.6: every 2 s) (default 2000)
#RID_INGEST_STATUS_INTERVAL_MS=2000

# a receiver silent for longer is stale (silent since T) (default 15)
#RID_INGEST_STALE_AFTER_S=15

# a receiver replaying backlog older than this is lagging with lag_s (B-03) (default 15)
#RID_INGEST_LAG_AFTER_S=15

# Retry-After of a disabled receiver's refusal (B-10) (default 30)
#RID_INGEST_DISABLED_RETRY_AFTER_S=30

# Retry-After of a work-queue refusal (default 2)
#RID_INGEST_QUEUE_RETRY_AFTER_S=2

# bound on one queue write, row hand-over or key-set read (default 2000)
#RID_INGEST_NATS_TIMEOUT_MS=2000

# KV bucket of the receiver key set, written by api (the same variable there) (default rid_receiver_keys)
#RID_KEYSET_BUCKET=rid_receiver_keys

# admit batches carrying X-Lab-Scenario (the scenario harness's simulated receiver, WP-25); false refuses them with 400 lab_header (spec 06 T11); true only in the lab (default false)
#LAB_HEADERS_ALLOWED=false

# concurrent argon2id checks of bearer keys not yet seen (T8); beyond it a request waits briefly and is refused with 503 (default 2)
#RID_INGEST_KEY_CHECK_SLOTS=2

# a Basic ID is usable this long after it was heard (I-01; policy identity_ttl_s) (default 15)
#RID_IDENTITY_TTL_S=15

# a transmitter silent longer is forgotten (I-01; policy max_gap_s) (default 3)
#RID_MAX_GAP_S=3

# a Location without a fresh identity waits this long before it is published unidentified (I-02; policy identify_within_s) (default 4)
#RID_IDENTIFY_WITHIN_S=4

# how far ahead of the receipt a broadcast time may be and be believed (T-07; policy broadcast_tolerance_s) (default 1)
#RID_BROADCAST_TOLERANCE_S=1

# how old a broadcast time may be at receipt and be believed (T-08; policy max_latency_s) (default 5)
#RID_MAX_LATENCY_S=5

# lowest known ODID vertical accuracy code at which the geodetic altitude is used; below it the pressure altitude stands in (R-08) (default 2)
#RID_MIN_VERTICAL_ACCURACY=2

# a track stays on its pressure altitude this long after the last poor geodetic fix (R-08) (default 10)
#RID_PRESSURE_HOLD_S=10

# longest spacing a row keeps within its batch before it is clamped and counted (T-02) (default 120)
#RID_MAX_BATCH_SPACING_S=120

# transmitter addresses each identity tracker holds; beyond it the one heard longest ago is evicted and counted (E-10) (default 50000)
#RID_MAX_TRANSMITTERS=50000

# tracks whose altitude hold and last identification are remembered; beyond it the least recently seen is forgotten and counted (E-10) (default 50000)
#RID_MAX_TRACKS=50000

# period of the registry projection re-read besides registry.v1.changed (G-08) (default 5)
#RID_PROJECTION_REFRESH_S=5

# period of the identity trackers' forgetting of silent transmitters (I-01) (default 1000)
#RID_TICK_MS=1000
