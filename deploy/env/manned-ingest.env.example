# Every variable manned-ingest reads, generated by scripts/gen-env-catalog.sh
# from its --help; do not edit. Defaults apply when a variable is unset;
# (required) ones have none, (secret) ones belong in AUTHORITY_SECRETS_DIR.
#

# minimum level of the JSON log on stdout (default info; one of debug, info, warn, error)
#LOG_LEVEL=info

# listen address of /healthz, /readyz and /metrics; private network only, never routed by Caddy (default :9090)
#ADMIN_ADDR=:9090

# seconds between status lines carrying every counter (E-09) (default 60)
#STATUS_INTERVAL_S=60

# bound on the drain after SIGTERM; the process exits non-zero when it is exceeded (default 15)
#SHUTDOWN_TIMEOUT_S=15

# OTLP/HTTP trace endpoint; tracing is a no-op when unset
#OTEL_EXPORTER_OTLP_ENDPOINT=

# this process's NATS credentials file (.creds); per-process credentials (plan §6); empty in the development stack
#NATS_CREDS=

# connection attempts at start before the process starts degraded and keeps connecting in the background (B-08) (default 3)
#NATS_START_ATTEMPTS=3

# wait after the first failed attempt at start; doubled after each (default 500)
#NATS_START_BACKOFF_MS=500

# bound on one connection attempt and on one KV read or write of the source-control state (default 2000)
#NATS_TIMEOUT_MS=2000

# storage of the TRK stream (the 1 h track mirror) (default file; one of file, memory)
#BUS_TRK_STORAGE=file

# hard bound of the INGEST work queue (discard new: a receiver is told 503); twice rid-ingest's shedding bound plus its batches in flight (default 120512)
#BUS_INGEST_MAX_MSGS=120512

# KV bucket of the source-control state (one key, the whole state) (default source_control)
#SOURCE_CONTROL_BUCKET=source_control

# push subject of every source-control state (default ctl.sources)
#SOURCE_CONTROL_SUBJECT=ctl.sources

# largest source-control state the bucket holds; a switch that would exceed it is refused naming the limit (E-10) (default 262144)
#SOURCE_CONTROL_MAX_VALUE_BYTES=262144

# seconds between re-reads of the source-control state by every follower, besides the watch and the push (default 5)
#SOURCE_CONTROL_REREAD_S=5

# NATS JetStream (required; secret)
#NATS_URL=

# the ANSP's published base URL (GET /v1/manned-traffic/snapshot and WS /v1/manned-traffic/stream under it); its host is the token audience (M18); unset: nothing is connected and the feed is shown unavailable (ansp_unconfigured)
#ANSP_BASE_URL=

# bbox of the stream and the snapshot, west,south,east,north in WGS84 degrees (Georgia or the designated areas); unset: the ANSP's relevance filter alone decides
#MANNED_BBOX=

# client certificate towards the ANSP; off only in the lab and on staging, said at error level on every status line (M25) (default required; one of required, off)
#AUTHORITY_MTLS_MODE=required

# PEM file of this system's client certificate towards the ANSP; required with AUTHORITY_MTLS_MODE=required
#MANNED_CLIENT_CERT=

# PEM file of that certificate's private key; required with AUTHORITY_MTLS_MODE=required
#MANNED_CLIENT_KEY=

# this system's issuer; its /oauth/token issues the ansp.traffic token unless MANNED_TOKEN_URL says otherwise
#ISSUER_URL=

# this system's client id at its own token service for the ANSP's manned traffic routes (scope ansp.traffic; M24) (default authority-01)
#MANNED_CLIENT_ID=authority-01

# file holding that client's secret (client_secret_post); unset: every connection to the ANSP is refused locally and the feed is shown unavailable (no_token)
#MANNED_CLIENT_SECRET_FILE=

# the token endpoint; default ISSUER_URL + /oauth/token
#MANNED_TOKEN_URL=

# source instance of the feed itself: its status on src.v1.ansp_feed.<instance> and its source switch (switching it off, or the type ansp_feed, closes the stream) (default ansp)
#MANNED_FEED_INSTANCE=ansp

# no frame for this long, console/status/v1 included, and the feed is stale (02 F4: 5 s) (default 5)
#MANNED_STALE_AFTER_S=5

# the freshest live aircraft older than this when it arrived and the feed is lagging, with lag_s (B-03: 15 s) (default 15)
#MANNED_LAG_AFTER_S=15

# interval of src.v1.ansp_feed.<instance> (04 §3.6: every 2 s) (default 2000)
#MANNED_STATUS_INTERVAL_MS=2000

# a connection that carried no frame for this long is closed and opened again (default 15)
#MANNED_SILENT_RECONNECT_S=15

# bound on the token, the snapshot and the WebSocket upgrade (default 5000)
#MANNED_REQUEST_TIMEOUT_MS=5000

# first reconnection delay, doubled up to MANNED_BACKOFF_MAX_MS, jittered; reconnection never stops (B-08) (default 500)
#MANNED_BACKOFF_MIN_MS=500

# longest reconnection delay (default 30000)
#MANNED_BACKOFF_MAX_MS=30000

# aircraft whose last published state is remembered; past it the one updated longest ago is forgotten and counted (E-10) (default 10000)
#MANNED_MAX_AIRCRAFT=10000

# a sample stamped more than this after it arrived is ordered at its arrival plus this, counted source_time_in_future, so an ANSP clock jump cannot freeze an aircraft (default 5000)
#MANNED_MAX_SOURCE_AHEAD_MS=5000

# largest frame read from the stream; a larger one closes the connection, which is opened again (default 4194304)
#MANNED_MAX_FRAME_BYTES=4194304

# largest snapshot read (default 16777216)
#MANNED_MAX_SNAPSHOT_BYTES=16777216

# aircraft taken from one snapshot; the rest are counted (default 10000)
#MANNED_MAX_SNAPSHOT_ITEMS=10000

# ANSP adapters followed; the rest are counted (default 64)
#MANNED_MAX_ADAPTERS=64

# row batches waiting for tsdb-writer; past it a batch is shed, counted and recorded as a writer gap (default 1024)
#MANNED_ROWS_QUEUE=1024

# bound on one row hand-over to tsdb-writer (default 2000)
#MANNED_NATS_TIMEOUT_MS=2000

# period of the re-application of source control to the aircraft held besides the follower's changes (default 5)
#MANNED_SWITCHES_REAPPLY_S=5
