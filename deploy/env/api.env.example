# Every variable api reads, generated by scripts/gen-env-catalog.sh
# from its --help; do not edit. Defaults apply when a variable is unset;
# (required) ones have none, (secret) ones belong in AUTHORITY_SECRETS_DIR.
#

# minimum level of the JSON log on stdout (default info; one of debug, info, warn, error)
#LOG_LEVEL=info

# listen address of /healthz, /readyz and /metrics; private network only, never routed by Caddy (default :9090)
#ADMIN_ADDR=:9090

# seconds between status lines carrying every counter (E-09) (default 60)
#STATUS_INTERVAL_S=60

# bound on the drain after SIGTERM; the process exits non-zero when it is exceeded (default 15)
#SHUTDOWN_TIMEOUT_S=15

# OTLP/HTTP trace endpoint; tracing is a no-op when unset
#OTEL_EXPORTER_OTLP_ENDPOINT=

# this process's NATS credentials file (.creds); per-process credentials (plan §6); empty in the development stack
#NATS_CREDS=

# connection attempts at start before the process starts degraded and keeps connecting in the background (B-08) (default 3)
#NATS_START_ATTEMPTS=3

# wait after the first failed attempt at start; doubled after each (default 500)
#NATS_START_BACKOFF_MS=500

# bound on one connection attempt and on one KV read or write of the source-control state (default 2000)
#NATS_TIMEOUT_MS=2000

# storage of the TRK stream (the 1 h track mirror) (default file; one of file, memory)
#BUS_TRK_STORAGE=file

# hard bound of the INGEST work queue (discard new: a receiver is told 503); twice rid-ingest's shedding bound plus its batches in flight (default 120512)
#BUS_INGEST_MAX_MSGS=120512

# KV bucket of the source-control state (one key, the whole state) (default source_control)
#SOURCE_CONTROL_BUCKET=source_control

# push subject of every source-control state (default ctl.sources)
#SOURCE_CONTROL_SUBJECT=ctl.sources

# largest source-control state the bucket holds; a switch that would exceed it is refused naming the limit (E-10) (default 262144)
#SOURCE_CONTROL_MAX_VALUE_BYTES=262144

# seconds between re-reads of the source-control state by every follower, besides the watch and the push (default 5)
#SOURCE_CONTROL_REREAD_S=5

# default request body cap; routes may override it (default 1048576)
#HTTP_MAX_BODY_BYTES=1048576

# time allowed to read request headers (default 5)
#HTTP_READ_HEADER_TIMEOUT_S=5

# sustained requests per second per client (default 20)
#HTTP_RATE_LIMIT_RPS=20

# burst size per client (default 40)
#HTTP_RATE_LIMIT_BURST=40

# clients tracked by the rate limiter; the least recently seen is evicted beyond it (default 10000)
#HTTP_RATE_LIMIT_MAX_CLIENTS=10000

# CIDRs or addresses of the reverse proxies (Caddy) whose X-Forwarded-For names the client; the rightmost hop that is not one of them is the client address of every limiter and audit row
#AUTHORITY_TRUSTED_PROXIES=

# public listen address (behind Caddy) (default :8080)
#API_ADDR=:8080

# relational database (PostgreSQL + PostGIS); only api opens it (required; secret)
#PG_URL=

# telemetry database (TimescaleDB): api writes the registry projection there (WP-3) (required; secret)
#TS_URL=

# NATS JetStream; may carry credentials (required; secret)
#NATS_URL=

# this system's published base URL; its host is the token audience and the issuer (required)
#AUTHORITY_PUBLIC_URL=

# accepted JWT audiences (hosts), comma-separated: own host plus a lab alias
#AUTHORITY_AUDIENCES=

# mTLS on machine routes; off only in the lab and on staging (default required; one of required, off)
#AUTHORITY_MTLS_MODE=required

# maximum connections of the relational pool (default 10)
#PG_MAX_CONNS=10

# statement_timeout of every relational connection (default 15)
#PG_STATEMENT_TIMEOUT_S=15

# role SET on every relational connection; the login user must be a member (migration 00002_events creates it) (default authority_app)
#PG_ROLE=authority_app

# seconds between re-reads of the active policy by its followers (the push is repaired by the re-read, G-08) (default 60)
#POLICY_REFRESH_S=60

# iss of every token this issuer signs and the base of its jwks_uri and token_endpoint; default AUTHORITY_PUBLIC_URL
#ISSUER_URL=

# token-signing RSA keys (PEM, at least 2048 bits), comma-separated paths outside the repository; the first is activated on an empty key table, later ones are rotation candidates (kms: references are refused by this build) (required)
#SIGNING_KEY_FILES=

# RSA key (PEM) of the detached publication JWS (M26), listed in the JWKS under its own kid; optional until WP-6
#PUBLICATION_KEY_FILE=

# lifetime of an ecosystem machine token (table A: at most 1 h) (default 3600)
#TOKEN_TTL_S=3600

# tokens per minute per authenticated client (default 60)
#TOKEN_RATE_LIMIT_PER_MIN=60

# token burst per client (default 20)
#TOKEN_RATE_LIMIT_BURST=20

# clients tracked by the token rate limiter; the least recently seen is evicted beyond it (default 1000)
#TOKEN_RATE_LIMIT_MAX_CLIENTS=1000

# a retired signing key stays in the JWKS this long (the verifiers' JWKS cache TTL) (default 86400)
#KEY_RETIRE_GRACE_S=86400

# a key rotation needs a second admin's confirmation (T4) (default true)
#KEY_ROTATION_TWO_PERSON=true

# window for the second admin's confirmation of a rotation (default 600)
#KEY_ROTATION_CONFIRM_S=600

# seconds between re-reads of the signing-key table, so every api replica follows a rotation (default 60)
#KEY_REFRESH_S=60

# argon2id memory in KiB (OWASP minimum 19456) (default 19456)
#ARGON2_MEMORY_KIB=19456

# argon2id iterations (OWASP minimum 2) (default 2)
#ARGON2_TIME=2

# argon2id parallelism (default 1)
#ARGON2_THREADS=1

# AES-256 key (one line of base64, openssl rand -base64 32) sealing TOTP secrets and other PII columns; outside the repository (required)
#PII_KEY_FILE=

# id stored beside every value sealed with PII_KEY_FILE (default pii-1)
#PII_KEY_ID=pii-1

# console session lifetime (table A: at most 12 h) (default 43200)
#SESSION_TTL_S=43200

# a session unused this long ends (table A: idle 30 min) (default 1800)
#SESSION_IDLE_S=1800

# live sessions per account; a new sign-in beyond it revokes the oldest (default 5)
#SESSION_MAX_PER_USER=5

# seconds between deletions of sessions and challenges expired a day ago (default 300)
#SESSION_SWEEP_S=300

# lifetime of the challenge between the password and the TOTP step (default 300)
#MFA_CHALLENGE_TTL_S=300

# wrong codes a challenge allows before it is spent (default 5)
#MFA_MAX_ATTEMPTS=5

# MFA failures of one account, across challenges and addresses, before it is locked for MFA_LOCKOUT_BASE_S (default 5)
#MFA_LOCKOUT_AFTER=5

# first MFA lock; each further failure doubles it up to MFA_LOCKOUT_MAX_S (default 60)
#MFA_LOCKOUT_BASE_S=60

# longest timed MFA lock (default 3600)
#MFA_LOCKOUT_MAX_S=3600

# consecutive MFA failures after which only an admin unlocks the account (NIST SP 800-63B: at most 100) (default 100)
#MFA_HARD_LOCK_AFTER=100

# sign-in attempts per minute per client address (S-15) (default 10)
#LOGIN_RATE_IP_PER_MIN=10

# sign-in burst per client address (default 10)
#LOGIN_RATE_IP_BURST=10

# sign-in attempts per minute per username, known or not (S-15) (default 5)
#LOGIN_RATE_USER_PER_MIN=5

# sign-in burst per username (default 5)
#LOGIN_RATE_USER_BURST=5

# addresses and usernames tracked by the sign-in limiters; the least recently seen is evicted beyond it (default 10000)
#LOGIN_RATE_MAX_KEYS=10000

# shortest password an admin may set (default 12)
#PASSWORD_MIN_LENGTH=12

# issuer label shown by authenticator apps (branding is configuration) (default uspace-authority)
#TOTP_ISSUER=uspace-authority

# creates this first admin when the users table is empty (one-shot, logged, refused when users exist)
#BOOTSTRAP_ADMIN_USERNAME=

# file holding the first admin's password; required with BOOTSTRAP_ADMIN_USERNAME
#BOOTSTRAP_ADMIN_PASSWORD_FILE=

# the CISP's issuer (CIS notifications, WP-6)
#CISP_ISSUER_URL=

# the CISP's JWKS URL (https)
#CISP_JWKS_URL=

# the ANSP's issuer (direct delivery, WP-6)
#ANSP_ISSUER_URL=

# the ANSP's JWKS URL (https)
#ANSP_JWKS_URL=

# the lab issuer, in the lab only (lab-01 stands in until A-M4)
#LAB_ISSUER_URL=

# the lab issuer's JWKS URL
#LAB_JWKS_URL=

# key (one line of base64, openssl rand -base64 32) of the keyed hashes of a registration number's secret part and a pilot's national id (spec 06 §5); outside the repository, never rotated without re-registering (required)
#REGISTRY_HASH_KEY_FILE=

# role SET on api's telemetry connections that write the registry projection (migration 00003_registry_projection) (default authority_ts_projector)
#TS_PROJECTOR_ROLE=authority_ts_projector

# maximum connections of api's telemetry pool (default 4)
#TS_MAX_CONNS=4

# seconds between full re-projections of the registry into the telemetry database (G-08: 300) (default 300)
#REGISTRY_REPROJECT_S=300

# first retry of a failed re-projection; each failure doubles it up to REGISTRY_REPROJECT_S (default 2)
#REGISTRY_REPAIR_RETRY_S=2

# seconds between runs of the job that marks registrations past valid_until expired (default 300)
#REGISTRY_EXPIRY_S=300

# ascending upper bounds in grams of the MTOM bands F8 answers (under_<g>g, from_<last>g); the defaults are the 2019/945 class limits (default 250,900,4000,25000)
#REGISTRY_MTOM_BANDS_G=250,900,4000,25000

# how often a receiver posts a batch unless its config says otherwise (F9: batches of at most 1 s) (default 1000)
#RID_DEFAULT_BATCH_INTERVAL_MS=1000

# observations a receiver buffers while the ingest is unreachable unless its config says otherwise (default 50000)
#RID_DEFAULT_BACKLOG_CAP=50000

# receiver heartbeat interval unless its config says otherwise (F9: 10 s) (default 10)
#RID_DEFAULT_HEARTBEAT_INTERVAL_S=10

# distance of a heartbeat's position from the pinned one beyond which it is counted as a deviation (T2) unless the receiver's config says otherwise (default 100)
#RID_DEFAULT_POSITION_TOLERANCE_M=100

# how long a rotated receiver key keeps working unless the rotation says otherwise (default 3600)
#RID_KEY_ROTATION_GRACE_S=3600

# seconds between full re-projections of the receiver key set into KV rid_receiver_keys (repair of a lost bucket) (default 60)
#RID_KEYSET_REPROJECT_S=60

# longest window of GET /v1/rid/frames; a longer one is refused, never thinned (B-13) (default 86400)
#RID_FRAMES_MAX_WINDOW_S=86400

# bound on one write of the receiver key set; a change whose write fails is refused with 503 (default 2000)
#RID_KV_TIMEOUT_MS=2000

# KV bucket of the receiver key set that rid-ingest reads (the same variable there) (default rid_receiver_keys)
#RID_KEYSET_BUCKET=rid_receiver_keys

# role SET on api's telemetry connections that read the raw Remote ID frames (SELECT only) (default authority_ts_reader)
#TS_READER_ROLE=authority_ts_reader

# an instance with no switch of its own is disabled (by default deny) unless its type is switched on; the flag travels in the published state (default false)
#SOURCES_DEFAULT_DENY=false

# seconds between republishes of the source-control state from the database (repairs a lost bucket) (default 60)
#SOURCE_CONTROL_REPUBLISH_S=60

# an adapter whose last src.v1 status is older is silent: its sources are shown stale (default 10)
#SOURCE_STATUS_STALE_S=10

# sources whose last status api keeps; past it the one heard longest ago is dropped and counted (E-10) (default 10000)
#SOURCE_STATUS_MAX=10000

# seconds between full re-projections of the published zones into the telemetry database (G-08: 300) (default 300)
#ZONES_REPROJECT_S=300

# first retry of a failed zones re-projection; each failure doubles it up to ZONES_REPROJECT_S (default 2)
#ZONES_REPAIR_RETRY_S=2

# the provider named in the metadata of every ED-318 export and publication (the authority's name, spec 06 §4); absent when empty
#ZONES_PROVIDER_NAME=

# language tag of ZONES_PROVIDER_NAME (at most five characters) (default en-GB)
#ZONES_PROVIDER_LANG=en-GB

# the CISP's published base URL (https; http only to a loopback host): F1 publications, the heartbeat and every F3 pull go there and nowhere else; its host is the audience of the authority's tokens for it (M18); unset: nothing is sent or pulled, said on the status line
#CISP_BASE_URL=

# this system's client id at its own token service for calls to the CISP (M24) (default authority-01)
#CISP_CLIENT_ID=authority-01

# file holding that client's secret (client_secret_post at CISP_TOKEN_URL); unset: every call to the CISP is refused locally and counted
#CISP_CLIENT_SECRET_FILE=

# the token endpoint the CISP client asks; default ISSUER_URL + /oauth/token
#CISP_TOKEN_URL=

# the URL the CISP posts change notifications to (this system's POST /v1/cis/notifications, M1); unset: no subscription, the 60 s reconciliation alone
#CIS_CALLBACK_URL=

# allow-list of POST /v1/cis/notifications, at most two <iss>=<jwks_url> entries: the CISP's (iss = CISP_ISSUER_URL) and the ANSP's direct delivery (iss = ANSP_ISSUER_URL, M5); unset: the configured CISP and ANSP peers
#AUTHORITY_CIS_NOTIFY_ISSUERS=

# the subscription's box: min lng, min lat, max lng, max lat (WGS84 degrees, comma-separated); unset: every change
#CIS_SUBSCRIPTION_BBOX=

# the ANSP's keys that verify the publisher signature of pulled restrictions versions; default ANSP_JWKS_URL
#CIS_ANSP_PUBLISHER_JWKS_URL=

# seconds between reconciliations of every CIS dataset (HEAD on the ETag, GET on a change); 02 F3 makes 60 s mandatory, whether or not notifications arrive (default 60)
#CIS_RECONCILE_S=60

# seconds between publisher heartbeats (M3: 15; the CISP marks a publisher stale after 60 s of silence) (default 15)
#CIS_HEARTBEAT_S=15

# first wait before a publication is sent again after a 5xx or no answer; each failure doubles it (default 2)
#CIS_SEND_BACKOFF_MIN_S=2

# longest wait between two attempts of a publication (02 F1: capped at 5 min) (default 300)
#CIS_SEND_BACKOFF_MAX_S=300

# a publication not acknowledged this long after it was queued is failed with its last reason (02 F1: 24 h) (default 86400)
#CIS_SEND_GIVE_UP_S=86400

# how old the publisher signature of a pulled version may be: the signature is as old as its version (366 days by default); an older one is held, visibly (default 31622400)
#CIS_PUBLISHER_SIG_MAX_AGE_S=31622400

# delivery ids remembered by the notification receiver; beyond it a notification is answered 503 and counted (E-10) (default 100000)
#CIS_JTI_MAX_LIVE=100000

# alrt.v1 messages delivered to api and not yet stored (max_ack_pending) (default 256)
#VIOLATIONS_MAX_ACK_PENDING=256

# ack wait of the alrt.v1 consumer (default 30)
#VIOLATIONS_ACK_WAIT_S=30

# alrt.v1 messages one pull asks for (default 64)
#VIOLATIONS_FETCH_MAX=64

# delay before a message whose write failed is delivered again (default 1000)
#VIOLATIONS_RETRY_MS=1000

# bound on one violation transaction (default 10)
#VIOLATIONS_WRITE_TIMEOUT_S=10

# track samples stored per violation; past it later samples are left out, flagged excerpt_truncated and counted (E-10) (default 600)
#VIOLATIONS_EXCERPT_MAX_SAMPLES=600

# an open violation detect has not republished for this long (database clock) is closed detector_silent; detect republishes every second (default 30)
#VIOLATIONS_SILENT_AFTER_S=30

# period of the detector_silent check (default 10)
#VIOLATIONS_SILENT_CHECK_S=10

# violations one detector_silent check closes at most (default 500)
#VIOLATIONS_SILENT_BATCH=500

# directory the sealed evidence packs are stored under (<incident>/<pack>.zip, never overwritten); unset: building, downloading and verifying a pack is refused with 503 evidence_storage_unavailable
#EVIDENCE_DIR=

# longest window of one evidence pack; a longer one is refused (window_too_large), never thinned (B-13) (default 21600)
#INCIDENTS_PACK_MAX_WINDOW_S=21600

# rows one section of a pack holds at most (tracks, frames, violations, events, ...); a section holding more refuses the pack (pack_too_large), never thinned (default 200000)
#INCIDENTS_PACK_MAX_ROWS=200000

# largest archive of one pack; a larger one is refused (pack_too_large) (default 268435456)
#INCIDENTS_PACK_MAX_BYTES=268435456

# zone versions one pack names and finds in force at most; past it the pack is refused (default 500)
#INCIDENTS_PACK_MAX_ZONES=500

# margin around the extent of the evidence's positions within which a pack includes the ANSP's manned traffic of the window (WP-15) (default 10000)
#INCIDENTS_MANNED_MARGIN_M=10000

# packs built at once per replica; past it a build is refused with 503 pack_busy and counted (E-10) (default 2)
#INCIDENTS_PACK_CONCURRENCY=2

# pack downloads and verifications at once per replica (each holds a whole archive in memory); past it 503 pack_busy, counted (default 4)
#INCIDENTS_PACK_READ_CONCURRENCY=4

# bound on one pack build, its source reads and USSP record fetches included (default 120)
#INCIDENTS_BUILD_TIMEOUT_S=120

# bound on one incident transaction (default 10)
#INCIDENTS_WRITE_TIMEOUT_S=10

# period of the job opening the incident of an escalation recorded without one (WP-12's incident_requested) (default 300)
#INCIDENTS_BACKFILL_S=300

# incidents that job opens at most per run (default 100)
#INCIDENTS_BACKFILL_BATCH=100

# this system's client id at its own token service for the USSP service-record reads (scope ussp.records, 02 F7; M24) (default authority-01)
#RECORDS_CLIENT_ID=authority-01

# file holding that client's secret; unset: every USSP record of a pack is unavailable with that reason
#RECORDS_CLIENT_SECRET_FILE=

# deadline of one USSP service-record fetch (default 5000)
#RECORDS_TIMEOUT_MS=5000

# largest USSP service record read; a larger one is unavailable with that reason (default 1048576)
#RECORDS_MAX_BYTES=1048576

# USSP service records fetched per pack at most; the rest are unavailable with that reason (default 16)
#RECORDS_MAX_PER_PACK=16

# USSP service records of a legal pack read at once (default 4)
#RECORDS_CONCURRENCY=4

# deadline of a legal pack's whole records step; the records not read by then are unavailable with that reason (oversight packs read none) (default 30)
#RECORDS_STEP_TIMEOUT_S=30

# AES-256 key (one line of base64, openssl rand -base64 32) sealing the occurrence reporter's person reference, separate from PII_KEY_FILE (a key equal to it stops the start); unset: a report carrying a person reference is refused 503 occurrence_key_unavailable and the reporter identity cannot be opened
#OCCURRENCE_KEY_FILE=

# id stored beside every value sealed with OCCURRENCE_KEY_FILE (default occ-1)
#OCCURRENCE_KEY_ID=occ-1

# role SET on every connection of the occurrences pool (migration 00020_occurrences creates it); the login user must be a member, and PG_ROLE has no grant on the occurrences schema (default authority_occurrences)
#PG_OCCURRENCES_ROLE=authority_occurrences

# maximum connections of the occurrences pool (default 4)
#PG_OCCURRENCES_MAX_CONNS=4

# reporting deadline after became_aware_at (376/2014 Art. 4(7)-(8): 72 h); a report received later is stored with within_72h false, never refused (default 259200)
#OCCURRENCES_REPORT_DEADLINE_S=259200

# how far became_aware_at may be ahead of the database clock before a report is refused (400 naming became_aware_at) (default 300)
#OCCURRENCES_CLOCK_SKEW_S=300

# the safety risk classification scheme of POST /v1/occurrences/{id}/classify (376/2014 Art. 7(2)), comma-separated; the default is the ECCAIRS occurrence class list (unverified against the taxonomy, Q-A12) (default accident,serious_incident,incident,occurrence_without_safety_effect,not_determined)
#OCCURRENCES_RISK_CLASSES=accident,serious_incident,incident,occurrence_without_safety_effect,not_determined

# the de-identified export's default format (Q-A12, owner-only: E5X is a later writer); the formats this build knows are listed at start (default eccairs-compatible-draft)
#OCCURRENCES_EXPORT_FORMAT=eccairs-compatible-draft

# reports one export holds at most; a window holding more is refused (export_too_large), never thinned (default 5000)
#OCCURRENCES_EXPORT_MAX_RECORDS=5000

# bytes one export document holds at most (32 MiB); a larger one is refused (export_too_large), never truncated (default 33554432)
#OCCURRENCES_EXPORT_MAX_BYTES=33554432

# bound on one occurrences transaction (default 10)
#OCCURRENCES_WRITE_TIMEOUT_S=10

# InterUSS DSS base URL (F3548 under /dss/v1); its host is the audience of the arbitration token (M18); unset: arbitration is refused with 503 dss_unconfigured
#DSS_BASE_URL=

# this system's client id at its own token service for the arbitration call to the DSS (M24) (default authority-01)
#DP_CLIENT_ID=authority-01

# file holding that client's secret; unset: arbitration is refused with 503
#DP_CLIENT_SECRET_FILE=

# KV bucket of the oversight areas dp-poller reads (the same variable there) (default dp_oversight)
#DP_OVERSIGHT_BUCKET=dp_oversight

# seconds between republishes of the oversight areas from the database (repairs a lost bucket) (default 60)
#DP_VIEWS_REPUBLISH_S=60

# Service Providers whose last dp-poller status api keeps; past it the one heard longest ago is dropped and counted (E-10) (default 256)
#DP_PROVIDERS_MAX=256

# period of the Art. 16(2) lapse job (daily; one replica at a time under an advisory lock, idempotent); the lapse periods themselves are authority_policy columns (default 86400)
#CERTIFICATES_LAPSE_EVERY_S=86400

# period of the repair of the USSP list (queued again when a change could not queue it or a certificate left it by expiry) and of the KV register dp-poller follows (default 60)
#CERTIFICATES_REPAIR_S=60

# KV bucket of the certified USSPs dp-poller follows (the same variable there) (default certificates)
#CERTIFICATES_BUCKET=certificates

# public register requests per minute per client address (behind the trusted proxies); past it 429 with Retry-After (default 60)
#CERTIFICATES_REGISTER_PER_MIN=60

# burst of the public register's per-address budget (default 20)
#CERTIFICATES_REGISTER_BURST=20

# the ANSP's published base URL: its host is an audience every certificate's client is issued for, so a USSP's ansp.traffic (F4) and ansp.coordination (F13) tokens name it (M18, cross-plan Appendix B); unset: clients issued meanwhile get no ANSP audience and their ANSP tokens are refused, said at start
#ANSP_BASE_URL=

# client addresses the register's limiter remembers; past it the one seen longest ago is forgotten and counted (E-10) (default 10000)
#CERTIFICATES_REGISTER_MAX_IPS=10000

# the purposes a police query may name, comma-separated (1 to 64 of [a-z0-9_], starting with a letter); any other is refused 400 naming purpose (Q-A14, the spec default, pending GCAA; national law and the DPO decide) (default public_order,traffic_enforcement,criminal_investigation,security_threat)
#POLICE_PURPOSES=public_order,traffic_enforcement,criminal_investigation,security_threat

# the purposes of POLICE_PURPOSES that release the operator's identity and allow a legal export; every other purpose answers status only (Q-A14, the spec default, pending GCAA) (default criminal_investigation,security_threat)
#POLICE_PII_PURPOSES=criminal_investigation,security_threat

# queries one police account may make per POLICE_RATE_WINDOW_S; past it 429 with Retry-After, counted on the database clock across replicas and restarts (E-10; the default is pending GCAA) (default 30)
#POLICE_USER_QUERIES=30

# queries all accounts of one agency may make per POLICE_RATE_WINDOW_S; past it 429 with Retry-After (the default is pending GCAA) (default 300)
#POLICE_AGENCY_QUERIES=300

# the window of the police budgets (the default is pending GCAA) (default 60)
#POLICE_RATE_WINDOW_S=60

# a track last seen within this many seconds of now is flying now (GET /v1/police/aircraft without at); a picture older than this is said degraded (default 30)
#POLICE_LIVE_WINDOW_S=30

# GET /v1/police/aircraft?at= answers the tracks seen within this many seconds either side of at (default 60)
#POLICE_AT_WINDOW_S=60

# the oldest at a police query may name (the online retention of tracks, 90 days, 05 §4); older is refused 400 (default 7776000)
#POLICE_HISTORY_MAX_AGE_S=7776000

# the longest side, in degrees of latitude or longitude, of a police query's box (default 1)
#POLICE_MAX_BBOX_DEG=1

# aircraft one answer holds at most; beyond, truncated: true (narrow the box) (default 200)
#POLICE_MAX_AIRCRAFT=200

# positions per aircraft one answer holds at most (the newest); beyond, positions_truncated: true (default 60)
#POLICE_MAX_POSITIONS=60

# aircraft of an operator's fleet one answer holds at most; beyond, fleet_truncated: true (default 200)
#POLICE_MAX_FLEET=200

# bound on one police query's reads and its record (default 10)
#POLICE_WRITE_TIMEOUT_S=10

# rows per list of GET /v1/audit/dpo-report; beyond, truncated: true (default 50000)
#DPO_REPORT_MAX_ROWS=50000

# the rules file mapping a uas.gov.ge export onto the registry (docs/runbooks/registry-import.md; agreed with GCAA, outside the repository); unset: POST /v1/registry/import is refused 503 import_not_configured; a file that does not check stops the start
#REGISTRY_IMPORT_RULES_FILE=

# the export URL agreed with GCAA (G-11: nothing is scraped), https, with {kind} replaced by operators and uas; unset: no periodic re-import
#REGISTRY_IMPORT_URL=

# file holding the bearer token of REGISTRY_IMPORT_URL, if the agreement names one
#REGISTRY_IMPORT_TOKEN_FILE=

# period of the re-import from REGISTRY_IMPORT_URL (pending GCAA: the agreed cadence); a failed fetch waits for the next period (default 86400)
#REGISTRY_IMPORT_EVERY_S=86400

# bound on one fetch of an export (default 60)
#REGISTRY_IMPORT_TIMEOUT_S=60

# largest export read (upload or fetch); larger is refused 413 (E-10) (default 8388608)
#REGISTRY_IMPORT_MAX_BYTES=8388608

# records one export holds at most; more is refused 400, never cut (E-10); the default leaves room inside REGISTRY_IMPORT_WRITE_TIMEOUT_S (a first import of 5000 records took about 18 s), so split a larger export (pending GCAA: the export's size) (default 2000)
#REGISTRY_IMPORT_MAX_ROWS=2000

# bound on one import's transaction, inside the listener's 30 s write timeout: past it the import is rolled back (503 import_timeout), never committed after its caller was cut off; split a larger export (default 25)
#REGISTRY_IMPORT_WRITE_TIMEOUT_S=25

# public GET /v1/registry/check requests per minute per client address (behind the trusted proxies); past it 429 with Retry-After (default 30)
#REGISTRY_CHECK_PER_MIN=30

# burst of the public check's per-address budget (default 10)
#REGISTRY_CHECK_BURST=10

# client addresses the check's limiter remembers; past it the one seen longest ago is forgotten and counted (E-10) (default 10000)
#REGISTRY_CHECK_MAX_IPS=10000

# the public portal's registration applications (Q-A11: only if the authority is the registry of record, spec Q4, pending GCAA); off: every application operation is 404 (default off; one of on, off)
#REGISTRY_APPLICATIONS=off

# operators' occurrence reports through an e-mailed link (2019/947 Art. 19(2)); off: POST /v1/registry/operator-links and /v1/occurrences/operator are 404 (default off; one of on, off)
#REGISTRY_OPERATOR_REPORTS=off

# key (one line of base64, openssl rand -base64 32) signing the portal's links and keying the address hashes of its budgets; required when either portal flag is on, and different from PII_KEY_FILE and REGISTRY_HASH_KEY_FILE
#REGISTRY_PORTAL_KEY_FILE=

# base URL of the public portal pages the e-mailed links open (the token travels in the fragment); required when either portal flag is on
#REGISTRY_PORTAL_URL=

# lifetime of an application's verification link (pending GCAA) (default 86400)
#REGISTRY_APPLICATION_VERIFY_TTL_S=86400

# decided applications are deleted this long after the decision (90 days; pending GCAA and the DPO), unverified ones a link lifetime after their link expired; the operator a decision registered stays in the registry (default 7776000)
#REGISTRY_APPLICATIONS_RETAIN_S=7776000

# validity of a registration approved without a valid_until (5 years; pending GCAA) (default 157680000)
#REGISTRY_APPLICATION_VALIDITY_S=157680000

# applications one client address may submit per REGISTRY_APPLICATIONS_WINDOW_S, counted in the database across replicas and restarts; past it 429 (pending GCAA) (default 5)
#REGISTRY_APPLICATIONS_PER_IP=5

# the window of the application and link budgets (default 3600)
#REGISTRY_APPLICATIONS_WINDOW_S=3600

# the leading letters of a number the portal issues (Q-A10, spec Q5: the EU country code by default, pending GCAA); the issued number must match the policy's registration_number_pattern (default GEO)
#REGISTRY_ISSUE_PREFIX=GEO

# random lower-case letters and digits after REGISTRY_ISSUE_PREFIX (the EU AMC form's 12, unverified; pending GCAA) (default 12)
#REGISTRY_ISSUE_RANDOM_LEN=12

# lifetime of an operator's occurrence-report link, spent by one report (default 86400)
#REGISTRY_OPERATOR_LINK_TTL_S=86400

# link requests per client address per REGISTRY_APPLICATIONS_WINDOW_S; past it 429 (default 10)
#REGISTRY_OPERATOR_LINKS_PER_IP=10

# links mailed to one operator per window; requests beyond it are answered 202 and mail nothing (counted) (default 5)
#REGISTRY_OPERATOR_LINKS_PER_OPERATOR=5

# host:port of the SMTP relay the portal's e-mails leave by; required when either portal flag is on
#REGISTRY_MAIL_SMTP_ADDR=

# how the SMTP connection is protected; none only to a loopback relay (default starttls; one of starttls, tls, none)
#REGISTRY_MAIL_TLS=starttls

# the From address of the portal's e-mails
#REGISTRY_MAIL_FROM=

# SMTP user (PLAIN auth over TLS); unset: no auth
#REGISTRY_MAIL_USER=

# file holding the SMTP password
#REGISTRY_MAIL_PASSWORD_FILE=

# period of the outbox sender (default 10)
#REGISTRY_MAIL_EVERY_S=10

# messages one run of the sender takes at most (default 20)
#REGISTRY_MAIL_BATCH=20

# delivery attempts of one message; past them it is failed for good (counted, an events row) and its content cleared; a permanent SMTP refusal (5xx) fails at once (default 8)
#REGISTRY_MAIL_MAX_ATTEMPTS=8

# first retry of a failed delivery; each failure doubles it up to an hour (default 60)
#REGISTRY_MAIL_RETRY_S=60

# bound on one delivery (default 30)
#REGISTRY_MAIL_TIMEOUT_S=30

# period of the purge of applications past their retention, spent links and old budget rows (default 3600)
#REGISTRY_PORTAL_PURGE_EVERY_S=3600

# days the telemetry hypertables (rid_observations, tracks, manned_tracks) stay online; older chunks are archived to ARCHIVE_URL, verified, then dropped (spec 05 §4, Q8: 90 days, pending GCAA) (default 90)
#RETENTION_ONLINE_DAYS=90

# years an archived chunk and a USSP daily records bundle are kept, counted from the end of the data's day; then deleted unless held (Q8: 2 years, pending GCAA) (default 2)
#RETENTION_ARCHIVE_YEARS=2

# years a closed violation (the authority's alerts) is kept after it closed; then deleted in batches unless held or an incident names it (Q8: 5 years for alerts and intents, pending GCAA; this system stores no intents) (default 5)
#RETENTION_VIOLATIONS_YEARS=5

# incidents and evidence packs are kept indefinitely (Q8, pending GCAA); no other value is implemented (default indefinite; one of indefinite)
#RETENTION_INCIDENTS=indefinite

# years a month of the audit log is kept after it ended; the oldest month is then dropped whole, its last hash kept as the chain's anchor, unless held (Q8: 10 years, pending GCAA) (default 10)
#RETENTION_AUDIT_YEARS=10

# the archive store: file:///<absolute directory> (an S3-compatible store is not implemented); unset: nothing is archived and so no telemetry chunk is dropped (said at error level every run)
#ARCHIVE_URL=

# how often api checks whether a retention, archive or verification job is due (each job's own period is on the database clock in job_runs, so a restart neither skips nor repeats a run) (default 60)
#RETENTION_TICK_S=60

# period of the retention job (archive, drops, deletions; daily) and of the USSP daily records pull (default 86400)
#RETENTION_EVERY_S=86400

# wait after a failed or interrupted run of a job before it is tried again (default 3600)
#RETENTION_RETRY_S=3600

# rows one deletion transaction removes at most (each batch commits with its events row) (default 1000)
#RETENTION_BATCH_ROWS=1000

# deletion batches one run makes at most per table; the rest waits for the next run (counted) (default 100)
#RETENTION_MAX_BATCHES=100

# telemetry chunks one run archives and drops at most; the rest waits for the next run (default 60)
#RETENTION_CHUNKS_PER_RUN=60

# bound on the export of one chunk (one COPY statement on its own connection) (default 3600)
#RETENTION_EXPORT_TIMEOUT_S=3600

# an incident references an archived chunk when it occurred within this margin of the chunk's range: the remote pilot positions of its aircraft are then kept in the archive (06 §5), and an open incident keeps the object past its archive period (default 86400)
#RETENTION_INCIDENT_MARGIN_S=86400

# active legal holds a retention check reads at most; past it every chunk and object is treated as held (fail closed, counted) (default 1000)
#RETENTION_MAX_HOLDS=1000

# largest USSP daily records bundle read and stored; a larger one is a missing day with that reason (default 67108864)
#ARCHIVE_MAX_OBJECT_BYTES=67108864

# role SET on api's telemetry connections of the archive job (timeseries 00013_archive) (default authority_ts_archiver)
#TS_ARCHIVER_ROLE=authority_ts_archiver

# days after a day ended before a USSP's daily records bundle still not fetched is an alarm (02 F7) (default 2)
#USSP_RECORDS_GRACE_DAYS=2

# days back the daily records pull tries each run (a missing day is retried until it leaves this window, then stays an alarm) (default 7)
#USSP_RECORDS_BACKFILL_DAYS=7

# bound on one daily records fetch (default 60)
#USSP_RECORDS_TIMEOUT_S=60

# operating USSPs the pull reads at most per run (default 100)
#USSP_RECORDS_MAX_USSPS=100

# evidence packs the monthly re-verification checks at most; past it the run is failed and says so (default 100000)
#EVIDENCE_REVERIFY_MAX=100000
