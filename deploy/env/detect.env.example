# Every variable detect reads, generated by scripts/gen-env-catalog.sh
# from its --help; do not edit. Defaults apply when a variable is unset;
# (required) ones have none, (secret) ones belong in AUTHORITY_SECRETS_DIR.
#

# minimum level of the JSON log on stdout (default info; one of debug, info, warn, error)
#LOG_LEVEL=info

# listen address of /healthz, /readyz and /metrics; private network only, never routed by Caddy (default :9090)
#ADMIN_ADDR=:9090

# seconds between status lines carrying every counter (E-09) (default 60)
#STATUS_INTERVAL_S=60

# bound on the drain after SIGTERM; the process exits non-zero when it is exceeded (default 15)
#SHUTDOWN_TIMEOUT_S=15

# OTLP/HTTP trace endpoint; tracing is a no-op when unset
#OTEL_EXPORTER_OTLP_ENDPOINT=

# this process's NATS credentials file (.creds); per-process credentials (plan §6); empty in the development stack
#NATS_CREDS=

# connection attempts at start before the process starts degraded and keeps connecting in the background (B-08) (default 3)
#NATS_START_ATTEMPTS=3

# wait after the first failed attempt at start; doubled after each (default 500)
#NATS_START_BACKOFF_MS=500

# bound on one connection attempt and on one KV read or write of the source-control state (default 2000)
#NATS_TIMEOUT_MS=2000

# storage of the TRK stream (the 1 h track mirror) (default file; one of file, memory)
#BUS_TRK_STORAGE=file

# hard bound of the INGEST work queue (discard new: a receiver is told 503); twice rid-ingest's shedding bound plus its batches in flight (default 120512)
#BUS_INGEST_MAX_MSGS=120512

# KV bucket of the source-control state (one key, the whole state) (default source_control)
#SOURCE_CONTROL_BUCKET=source_control

# push subject of every source-control state (default ctl.sources)
#SOURCE_CONTROL_SUBJECT=ctl.sources

# largest source-control state the bucket holds; a switch that would exceed it is refused naming the limit (E-10) (default 262144)
#SOURCE_CONTROL_MAX_VALUE_BYTES=262144

# seconds between re-reads of the source-control state by every follower, besides the watch and the push (default 5)
#SOURCE_CONTROL_REREAD_S=5

# telemetry database (projections, read only) (required; secret)
#TS_URL=

# NATS JetStream (required; secret)
#NATS_URL=

# directory of the terrain tiles (<cell>.pgm) and their index.json, fetched by deploy/fetch-ground.sh; unset: AGL limits are not judged (limit_not_judged) and the height limit is not evaluated
#GROUND_DIR=

# terrain tiles held in memory (about 26 MB each for GLO-30), least recently used out first (default 16)
#GROUND_TILE_CACHE=16

# a tile that could not be read is answered as unknown ground this long before it is read again (D-04) (default 60)
#GROUND_RETRY_AFTER_S=60

# GeographicLib geoid grid (egm2008-2_5.pgm, fetched by deploy/fetch-ground.sh); unset: no AMSL altitude from HAE, said at start and on every status line (R-07)
#GEOID_FILE=

# this worker's id in the cell ownership map (KV cells, PUT /v1/cells) (default detect-1)
#DETECT_WORKER_ID=detect-1

# all: judge every cell whatever the ownership map says (the demo); empty: the cells the map gives DETECT_WORKER_ID, and refuse to start with none (one of all)
#CELLS=

# tracks delivered to a worker and not yet acknowledged (max_ack_pending, 05 §5) (default 1000)
#DETECT_MAX_ACK_PENDING=1000

# ack wait of the track consumers (default 30)
#DETECT_ACK_WAIT_S=30

# tracks one pull asks for (default 256)
#DETECT_FETCH_MAX=256

# aircraft one monitor holds (alerting.Config.MaxAircraft, C-18); past it an aircraft without an open violation is evicted, and with none a new one is refused, counted and logged at error level (E-10) (default 50000)
#DETECT_MAX_AIRCRAFT=50000

# seconds of track samples a violation copies at its raise (evidence_excerpt, 03 §1) (default 10)
#DETECT_EXCERPT_WINDOW_S=10

# samples kept per aircraft for the excerpt; past it the oldest is dropped and counted (E-10) (default 64)
#DETECT_EXCERPT_MAX_SAMPLES=64

# raises and clears waiting for the ALRT stream; past it the oldest is dropped, counted and logged at error level (default 10000)
#DETECT_OUTBOX_MAX=10000

# bound on one violation write to ALRT (default 2000)
#DETECT_PUBLISH_TIMEOUT_MS=2000

# bound on the publishing of one tick (outbox and republication of active violations); what is left is deferred to the next tick (default 500)
#DETECT_TICK_BUDGET_MS=500

# period of the zones projection re-read besides zones.v1.changed (G-08) (default 60)
#DETECT_ZONES_REFRESH_S=60

# period of the restrictions projection re-read besides cis.v1.restrictions (G-08, Z-12) (default 60)
#DETECT_RESTRICTIONS_REFRESH_S=60

# period of the KV policy re-read besides its watch and ctl.policy (G-08) (default 60)
#DETECT_POLICY_REREAD_S=60

# connections of the read-only projection pool (default 2)
#TS_MAX_CONNS=2

# InterUSS DSS base URL (F3548 under /dss/v1); its host is the audience of the tokens towards it (M18); unset: no_authorisation is not judged
#DSS_BASE_URL=

# this system's issuer, whose /oauth/token the detector asks for its DSS token (unless DETECT_TOKEN_URL)
#ISSUER_URL=

# this system's client id at its own token service for the detector's DSS reads (M24) (default authority-01)
#DETECT_CLIENT_ID=authority-01

# file holding that client's secret (client_secret_post); unset: no DSS read is made and no_authorisation is not judged
#DETECT_CLIENT_SECRET_FILE=

# the token endpoint the detector asks; default ISSUER_URL + /oauth/token
#DETECT_TOKEN_URL=

# period of the read of every U-space airspace in force (F3548 subscriptions need utm.strategic_coordination, which the authority does not hold, Q-A5: the period stands in for them) (default 5)
#DETECT_INTENT_REQUERY_S=5

# how far ahead an airspace is read (the next hour) (default 3600)
#DETECT_INTENT_HORIZON_S=3600

# least time between two reads of one aircraft's position (default 2000)
#DETECT_INTENT_RECHECK_MS=2000

# aircraft positions read from the DSS per second at most; the rest wait (counted intent_checks_deferred) (default 20)
#DETECT_INTENT_CHECKS_PER_S=20

# radius of the area asked around an aircraft's position (default 10)
#DETECT_INTENT_CHECK_RADIUS_M=10

# each way around an aircraft's WGS84 height in the area asked (default 10)
#DETECT_INTENT_VERTICAL_MARGIN_M=10

# how long an aircraft's last judgement stands; past it the aircraft is suspended (neither raised nor cleared) (default 10)
#DETECT_INTENT_OUTCOME_MAX_AGE_S=10

# aircraft inside U-space airspace held for no_authorisation; past it a new one is refused and counted (E-10) (default 10000)
#DETECT_INTENT_MAX_AIRCRAFT=10000

# U-space airspaces read; past it the rest are counted and not judged (default 64)
#DETECT_INTENT_MAX_ZONES=64

# operational intent references held; past it the oldest withdrawn, else the one seen longest ago, is dropped and counted (E-10); none is kept past 24 h (default 10000)
#DETECT_INTENT_MAX_CACHED=10000

# references taken from one DSS answer; a larger answer is refused whole and the detector suspended (default 1000)
#DETECT_INTENT_MAX_REFS=1000

# largest DSS answer read (default 1048576)
#DETECT_INTENT_MAX_BODY_BYTES=1048576

# deadline of one DSS read (default 5000)
#DETECT_INTENT_REQUEST_TIMEOUT_MS=5000
