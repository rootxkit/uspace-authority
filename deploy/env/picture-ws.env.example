# Every variable picture-ws reads, generated by scripts/gen-env-catalog.sh
# from its --help; do not edit. Defaults apply when a variable is unset;
# (required) ones have none, (secret) ones belong in AUTHORITY_SECRETS_DIR.
#

# minimum level of the JSON log on stdout (default info; one of debug, info, warn, error)
#LOG_LEVEL=info

# listen address of /healthz, /readyz and /metrics; private network only, never routed by Caddy (default :9090)
#ADMIN_ADDR=:9090

# seconds between status lines carrying every counter (E-09) (default 60)
#STATUS_INTERVAL_S=60

# bound on the drain after SIGTERM; the process exits non-zero when it is exceeded (default 15)
#SHUTDOWN_TIMEOUT_S=15

# OTLP/HTTP trace endpoint; tracing is a no-op when unset
#OTEL_EXPORTER_OTLP_ENDPOINT=

# this process's NATS credentials file (.creds); per-process credentials (plan §6); empty in the development stack
#NATS_CREDS=

# connection attempts at start before the process starts degraded and keeps connecting in the background (B-08) (default 3)
#NATS_START_ATTEMPTS=3

# wait after the first failed attempt at start; doubled after each (default 500)
#NATS_START_BACKOFF_MS=500

# bound on one connection attempt and on one KV read or write of the source-control state (default 2000)
#NATS_TIMEOUT_MS=2000

# storage of the TRK stream (the 1 h track mirror) (default file; one of file, memory)
#BUS_TRK_STORAGE=file

# hard bound of the INGEST work queue (discard new: a receiver is told 503); twice rid-ingest's shedding bound plus its batches in flight (default 120512)
#BUS_INGEST_MAX_MSGS=120512

# KV bucket of the source-control state (one key, the whole state) (default source_control)
#SOURCE_CONTROL_BUCKET=source_control

# push subject of every source-control state (default ctl.sources)
#SOURCE_CONTROL_SUBJECT=ctl.sources

# largest source-control state the bucket holds; a switch that would exceed it is refused naming the limit (E-10) (default 262144)
#SOURCE_CONTROL_MAX_VALUE_BYTES=262144

# seconds between re-reads of the source-control state by every follower, besides the watch and the push (default 5)
#SOURCE_CONTROL_REREAD_S=5

# default request body cap; routes may override it (default 1048576)
#HTTP_MAX_BODY_BYTES=1048576

# time allowed to read request headers (default 5)
#HTTP_READ_HEADER_TIMEOUT_S=5

# sustained requests per second per client (default 20)
#HTTP_RATE_LIMIT_RPS=20

# burst size per client (default 40)
#HTTP_RATE_LIMIT_BURST=40

# clients tracked by the rate limiter; the least recently seen is evicted beyond it (default 10000)
#HTTP_RATE_LIMIT_MAX_CLIENTS=10000

# CIDRs or addresses of the reverse proxies (Caddy) whose X-Forwarded-For names the client; the rightmost hop that is not one of them is the client address of every limiter and audit row
#AUTHORITY_TRUSTED_PROXIES=

# public listen address of /v1/picture/* (behind Caddy) (default :8083)
#PICTURE_ADDR=:8083

# telemetry database (projections, read only) (required; secret)
#TS_URL=

# NATS JetStream (required; secret)
#NATS_URL=

# this system's published base URL; its host is the audience of the sessions the picture accepts, its origin the default allowed origin (required)
#AUTHORITY_PUBLIC_URL=

# accepted session audiences (hosts), comma-separated: own host plus a lab alias; default the host of AUTHORITY_PUBLIC_URL
#AUTHORITY_AUDIENCES=

# iss of the sessions the picture accepts (this system's issuer); default AUTHORITY_PUBLIC_URL
#ISSUER_URL=

# origins (scheme://host[:port]) a console may open the WebSocket from, comma-separated, exact match (M22); default the origin of AUTHORITY_PUBLIC_URL
#PICTURE_ALLOWED_ORIGINS=

# api's GET /v1/auth/session on the private network (http://api:8080/v1/auth/session in compose): every session is checked there against the sessions table, so a logout or a revocation ends the stream (required)
#PICTURE_SESSION_URL=

# this issuer's JWKS (https; http only to a loopback host); default ISSUER_URL + /.well-known/jwks.json
#PICTURE_JWKS_URL=

# seconds between re-checks of a connection's session against the sessions table; a revoked session is closed with 4401 within this (default 15)
#PICTURE_SESSION_RECHECK_S=15

# a connection whose session cannot be re-checked (api unreachable) is kept this long after its last good check, then closed with 1013 (default 60)
#PICTURE_SESSION_GRACE_S=60

# bound on one session check against api (default 2000)
#PICTURE_SESSION_TIMEOUT_MS=2000

# WebSocket connections this instance serves; the next upgrade is refused with 503 (default 500)
#PICTURE_MAX_CLIENTS=500

# live frames queued per connection; a frame that does not fit is dropped and counted in that connection's dropped_frames (default 1024)
#PICTURE_SEND_BUFFER=1024

# bound on one frame write; a connection that does not take a frame within it is closed (default 5)
#PICTURE_WRITE_TIMEOUT_S=5

# interval of console/status/v1 frames and of the source and alert checks (M29: 2 s) (default 2000)
#PICTURE_STATUS_INTERVAL_MS=2000

# c5 cells one viewport may cover with its one-cell margin; a larger viewport is refused and the connection keeps its previous one (E-10) (default 2000)
#PICTURE_MAX_CELLS=2000

# tracks the cache holds; past it the one updated longest ago is evicted and counted (E-10) (default 50000)
#PICTURE_MAX_TRACKS=50000

# manned aircraft the cache holds; past it the one updated longest ago is evicted and counted (default 10000)
#PICTURE_MAX_MANNED=10000

# active violations held for replay to a connecting console (C-08); past it the one heard longest ago is evicted and counted (default 10000)
#PICTURE_MAX_ALERTS=10000

# a viewport holding more tracks than this is throttled per track (05 §3: 200) (default 200)
#PICTURE_THROTTLE_ABOVE_TRACKS=200

# frames per track per second to a throttled viewport (05 §3: 2 Hz) (default 2)
#PICTURE_THROTTLE_HZ=2

# an active violation detect has not republished for this long is shown unconfirmed (detect republishes every second, C-08) (default 5)
#PICTURE_ALERT_SILENT_S=5

# an active violation neither republished nor cleared for this long leaves the picture, counted and logged; a later republish brings it back (default 120)
#PICTURE_ALERT_FORGET_S=120

# seconds of ALRT read back at start, so active violations are replayed at once (C-08) (default 10)
#PICTURE_ALERT_REPLAY_S=10

# ALRT messages one read-back takes at most (at start, and after the bus comes back from the instant it was lost); past it the rest is counted and logged (default 100000)
#PICTURE_ALERT_REPLAY_MAX=100000

# seconds between reads of the projection ages and versions (database clock) (default 5)
#PICTURE_PROJECTION_REFRESH_S=5

# connections of the read-only projection pool (default 2)
#TS_MAX_CONNS=2

# period of the KV policy re-read besides its watch and ctl.policy (G-08) (default 60)
#PICTURE_POLICY_REREAD_S=60

# KV bucket the consoles' viewports are reported to for the Display Provider (WP-14; the same variable in dp-poller) (default dp_views)
#DP_VIEWS_BUCKET=dp_views

# largest frame a console may send (console/subscribe/v1); a larger one closes the connection with 1009 (default 4096)
#PICTURE_SUBSCRIBE_MAX_BYTES=4096

# subscriptions of one connection are applied at most this often; one arriving sooner waits, and those it supersedes meanwhile are never applied (subscribes_coalesced) (default 100)
#PICTURE_SUBSCRIBE_MIN_INTERVAL_MS=100

# bound on the items of one console/snapshot/v1 (violations first, then tracks, then manned); past it the rest is left out and the snapshot says truncated (E-10) (default 8388608)
#PICTURE_SNAPSHOT_MAX_BYTES=8388608

# an adapter whose last src.v1 status is older is silent: its sources are shown stale (default 10)
#SOURCE_STATUS_STALE_S=10

# sources whose last status the picture keeps; past it the one heard longest ago is dropped and counted (E-10) (default 10000)
#SOURCE_STATUS_MAX=10000
