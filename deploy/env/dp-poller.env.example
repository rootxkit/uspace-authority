# Every variable dp-poller reads, generated by scripts/gen-env-catalog.sh
# from its --help; do not edit. Defaults apply when a variable is unset;
# (required) ones have none, (secret) ones belong in AUTHORITY_SECRETS_DIR.
#

# minimum level of the JSON log on stdout (default info; one of debug, info, warn, error)
#LOG_LEVEL=info

# listen address of /healthz, /readyz and /metrics; private network only, never routed by Caddy (default :9090)
#ADMIN_ADDR=:9090

# seconds between status lines carrying every counter (E-09) (default 60)
#STATUS_INTERVAL_S=60

# bound on the drain after SIGTERM; the process exits non-zero when it is exceeded (default 15)
#SHUTDOWN_TIMEOUT_S=15

# OTLP/HTTP trace endpoint; tracing is a no-op when unset
#OTEL_EXPORTER_OTLP_ENDPOINT=

# this process's NATS credentials file (.creds); per-process credentials (plan §6); empty in the development stack
#NATS_CREDS=

# connection attempts at start before the process starts degraded and keeps connecting in the background (B-08) (default 3)
#NATS_START_ATTEMPTS=3

# wait after the first failed attempt at start; doubled after each (default 500)
#NATS_START_BACKOFF_MS=500

# bound on one connection attempt and on one KV read or write of the source-control state (default 2000)
#NATS_TIMEOUT_MS=2000

# storage of the TRK stream (the 1 h track mirror) (default file; one of file, memory)
#BUS_TRK_STORAGE=file

# hard bound of the INGEST work queue (discard new: a receiver is told 503); twice rid-ingest's shedding bound plus its batches in flight (default 120512)
#BUS_INGEST_MAX_MSGS=120512

# KV bucket of the source-control state (one key, the whole state) (default source_control)
#SOURCE_CONTROL_BUCKET=source_control

# push subject of every source-control state (default ctl.sources)
#SOURCE_CONTROL_SUBJECT=ctl.sources

# largest source-control state the bucket holds; a switch that would exceed it is refused naming the limit (E-10) (default 262144)
#SOURCE_CONTROL_MAX_VALUE_BYTES=262144

# seconds between re-reads of the source-control state by every follower, besides the watch and the push (default 5)
#SOURCE_CONTROL_REREAD_S=5

# default request body cap; routes may override it (default 1048576)
#HTTP_MAX_BODY_BYTES=1048576

# time allowed to read request headers (default 5)
#HTTP_READ_HEADER_TIMEOUT_S=5

# sustained requests per second per client (default 20)
#HTTP_RATE_LIMIT_RPS=20

# burst size per client (default 40)
#HTTP_RATE_LIMIT_BURST=40

# clients tracked by the rate limiter; the least recently seen is evicted beyond it (default 10000)
#HTTP_RATE_LIMIT_MAX_CLIENTS=10000

# CIDRs or addresses of the reverse proxies (Caddy) whose X-Forwarded-For names the client; the rightmost hop that is not one of them is the client address of every limiter and audit row
#AUTHORITY_TRUSTED_PROXIES=

# public listen address of /uss/* and /v1/dp/observations/* (behind Caddy) (default :8082)
#DP_ADDR=:8082

# telemetry database (registry projection, read only) (required; secret)
#TS_URL=

# NATS JetStream (required; secret)
#NATS_URL=

# this system's published base URL; its host is the audience a Service Provider's notification and the conformance hook must carry (M18) (required)
#AUTHORITY_PUBLIC_URL=

# accepted JWT audiences (hosts), comma-separated: own host plus a lab alias; default the host of AUTHORITY_PUBLIC_URL
#AUTHORITY_AUDIENCES=

# this system's issuer (iss of the tokens it accepts and the base of its token endpoint); default AUTHORITY_PUBLIC_URL
#ISSUER_URL=

# this issuer's JWKS (https; http only to a loopback host); default ISSUER_URL + /.well-known/jwks.json
#DP_JWKS_URL=

# InterUSS DSS base URL (F3411 under /rid/v2); its host is the audience of the tokens towards it (M18); unset: nothing is discovered and the status says dss_unconfigured
#DSS_BASE_URL=

# uss_base_url of this Display Provider's DSS subscriptions, where a Service Provider posts ISA changes (POST {uss_base_url}/uss/identification_service_areas/{id}); default AUTHORITY_PUBLIC_URL
#DP_USS_BASE_URL=

# the CISP's issuer (CIS notifications, WP-6)
#CISP_ISSUER_URL=

# the CISP's JWKS URL (https)
#CISP_JWKS_URL=

# the ANSP's issuer (direct delivery, WP-6)
#ANSP_ISSUER_URL=

# the ANSP's JWKS URL (https)
#ANSP_JWKS_URL=

# the lab issuer, in the lab only (lab-01 stands in until A-M4)
#LAB_ISSUER_URL=

# the lab issuer's JWKS URL
#LAB_JWKS_URL=

# this system's client id at its own token service for calls to the DSS and to Service Providers (M24) (default authority-01)
#DP_CLIENT_ID=authority-01

# file holding that client's secret (client_secret_post at DP_TOKEN_URL); unset: every outbound call is refused locally and counted, and nothing is discovered or polled
#DP_CLIENT_SECRET_FILE=

# the token endpoint the Display Provider asks; default ISSUER_URL + /oauth/token
#DP_TOKEN_URL=

# GeographicLib geoid grid (egm2008-2_5.pgm, fetched by deploy/fetch-ground.sh); unset: no AMSL altitude from HAE, said at start and on every status line (R-07)
#GEOID_FILE=

# deadline of one poll of a Service Provider; a poll past it keeps the flights already shown, which age on the picture (R-14) (default 5000)
#DP_REQUEST_TIMEOUT_MS=5000

# largest response read from a Service Provider or the DSS; a larger one is refused and counted (R-14: 1 MiB) (default 1048576)
#DP_MAX_BODY_BYTES=1048576

# flights taken from one response; the rest are counted and logged (R-14: 500) (default 500)
#DP_MAX_FLIGHTS_PER_RESPONSE=500

# tiles one Service Provider is polled for; past it the tiles are counted and not polled (R-14: 64) (default 64)
#DP_MAX_TILES_PER_SP=64

# details fetches after one poll at most (R-14: 20) (default 20)
#DP_MAX_DETAILS_PER_POLL=20

# details fetches in flight at once per poll (R-14: 4) (default 4)
#DP_DETAILS_CONCURRENCY=4

# a Service Provider whose polls fail for this long is shown unavailable since T, never removed (R-14: 10 s) (default 10)
#DP_UNAVAILABLE_AFTER_S=10

# poll rate of a Service Provider slower than the F3411 p99 of 3 s (05 §5: 0.5 Hz) (default 0.5)
#DP_SLOW_POLL_HZ=0.5

# a 413 from a Service Provider splits the tile into four, at most this many times (R-14: 3) (default 3)
#DP_MAX_SPLIT_DEPTH=3

# views (oversight areas and console viewports) followed; past it the rest are counted and logged (default 64)
#DP_MAX_VIEWS=64

# tiles discovered and subscribed in all; past it the rest are counted and logged (default 512)
#DP_MAX_TILES=512

# identification service areas held; past it a new one is refused and counted (default 10000)
#DP_MAX_ISAS=10000

# Service Providers held; past it a new one is counted and not polled, unless a DSS-listed ISA names it and a provider only notifications named can give way (default 256)
#DP_MAX_PROVIDERS=256

# a Service Provider no held ISA names for this long is forgotten (its status goes) (default 600)
#DP_PROVIDER_FORGET_AFTER_S=600

# an ISA learned from a notification is trusted until its time_end, capped at now plus this (F3411: 24 h); a DSS search that does not list it drops it earlier (default 86400)
#DP_NOTIFIED_ISA_MAX_LIFETIME_S=86400

# flights whose last published state, details and identification are remembered; past it the one seen longest ago is forgotten and counted (E-10) (default 50000)
#DP_MAX_FLIGHTS_HELD=50000

# seconds between ISA searches per tile besides the notifications (repair, G-08) (default 30)
#DP_DISCOVERY_REREAD_S=30

# seconds between reads of the oversight areas and the console viewports (default 5)
#DP_VIEWS_REREAD_S=5

# interval of src.v1.network_rid.<uss_id> status messages (04 §3.6: every 2 s) (default 2000)
#DP_STATUS_INTERVAL_MS=2000

# largest ISA change notification accepted (default 262144)
#DP_MAX_NOTIFICATION_BYTES=262144

# KV bucket of the certified USSPs api publishes (WP-16); a Service Provider whose ISA owner is not on it is still polled and shown provider_unknown (default certificates)
#CERTIFICATES_BUCKET=certificates

# seconds between reads of the certified USSPs (default 10)
#DP_CERTIFICATES_REREAD_S=10

# KV bucket of the oversight areas api publishes (POST /v1/dp/views) (default dp_oversight)
#DP_OVERSIGHT_BUCKET=dp_oversight

# KV bucket of the console viewports picture-ws reports, with a TTL so an idle console stops polling (default dp_views)
#DP_VIEWS_BUCKET=dp_views

# period of the registry projection re-read besides registry.v1.changed (G-08) (default 5)
#DP_PROJECTION_REFRESH_S=5

# period of the KV policy re-read besides its watch and ctl.policy (G-08) (default 60)
#DP_POLICY_REREAD_S=60

# bound on one row hand-over to tsdb-writer or one KV read (default 2000)
#DP_NATS_TIMEOUT_MS=2000
