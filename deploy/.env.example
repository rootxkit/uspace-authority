# Example environment for running a process against the development
# stack (make up). Every variable a process reads is listed by
# `go run ./cmd/<process> --help`. Throwaway local values only: real
# URLs and secrets come from the private deployment repository.
#
#   set -a; . deploy/.env.example; set +a; go run ./cmd/api

LOG_LEVEL=info
ADMIN_ADDR=127.0.0.1:9090
STATUS_INTERVAL_S=60
SHUTDOWN_TIMEOUT_S=15
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318/v1/traces

PG_URL=postgres://authority:authority@localhost:56432/authority?sslmode=disable
PG_MAX_CONNS=10
PG_STATEMENT_TIMEOUT_S=15
PG_ROLE=authority_app
POLICY_REFRESH_S=60
TS_URL=postgres://postgres:authority@localhost:56433/authority_ts?sslmode=disable
NATS_URL=nats://127.0.0.1:56422

API_ADDR=127.0.0.1:8080
AUTHORITY_PUBLIC_URL=http://localhost:8080
AUTHORITY_AUDIENCES=localhost,authority
AUTHORITY_MTLS_MODE=off

# WP-2: token service and console sign-in. Keys live outside the
# repository (docs/runbooks/token-service.md): generate them into local/
# (git-ignored) with
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:3072 -out local/token-1.pem
#   openssl rand -base64 32 > local/pii.key
SIGNING_KEY_FILES=local/token-1.pem
# PUBLICATION_KEY_FILE=local/publication-1.pem
PII_KEY_FILE=local/pii.key
# WP-3: the registry's keyed hashes (secret part, national id):
#   openssl rand -base64 32 > local/registry-hash.key
REGISTRY_HASH_KEY_FILE=local/registry-hash.key
# WP-6: the CISP client (docs/runbooks/cisp-publication.md). Without
# CISP_BASE_URL publications are queued and never sent; without
# PUBLICATION_KEY_FILE every publication is refused. The client secret
# is authority-01's at this issuer (created through /v1/oauth/clients).
# CISP_BASE_URL=https://cisp.example.test
# CISP_CLIENT_ID=authority-01
# CISP_CLIENT_SECRET_FILE=local/authority-01.secret
# CIS_CALLBACK_URL=https://authority.example.test/v1/cis/notifications
# AUTHORITY_CIS_NOTIFY_ISSUERS defaults to the CISP and ANSP peers below.
# CIS_RECONCILE_S=60
# CIS_HEARTBEAT_S=15
# WP-5: the provider named in the metadata of every ED-318 export and
# publication (the authority's name is configuration, spec 06 §4).
# ZONES_PROVIDER_NAME=Test authority
# ZONES_PROVIDER_LANG=en-GB
# ISSUER_URL defaults to AUTHORITY_PUBLIC_URL.
# BOOTSTRAP_ADMIN_USERNAME=admin
# BOOTSTRAP_ADMIN_PASSWORD_FILE=local/admin.pw
# The lab issuer while it stands in for this one (lab WP-L2):
# LAB_ISSUER_URL=https://lab.example.test
# LAB_JWKS_URL=https://lab.example.test/.well-known/jwks.json
# The reverse proxy whose X-Forwarded-For names the client (Caddy on the
# compose network); without it every client behind Caddy shares one
# rate-limit bucket and the audit records the proxy's address.
# AUTHORITY_TRUSTED_PROXIES=172.16.0.0/12
# WP-18: occurrence reports (docs/runbooks/occurrences.md). The reporter
# reference is sealed with a key of its own, never the PII key:
#   openssl rand -base64 32 > local/occurrence.key
# Without it a report carrying a reporter reference is refused 503.
# OCCURRENCE_KEY_FILE=local/occurrence.key
# PG_OCCURRENCES_ROLE=authority_occurrences
# OCCURRENCES_REPORT_DEADLINE_S=259200
# OCCURRENCES_RISK_CLASSES=accident,serious_incident,incident,occurrence_without_safety_effect,not_determined
# OCCURRENCES_EXPORT_FORMAT=eccairs-compatible-draft
# The export byte bound is set, not left to the default: a larger
# export is refused (export_too_large), never truncated.
OCCURRENCES_EXPORT_MAX_BYTES=33554432
# WP-19: the police realm (docs/runbooks/police-realm.md). The purpose
# lists and the budgets are the owner's and the DPO's decision (spec Q8,
# Q-A14); these are the spec's defaults, pending GCAA.
# POLICE_PURPOSES=public_order,traffic_enforcement,criminal_investigation,security_threat
# POLICE_PII_PURPOSES=criminal_investigation,security_threat
# POLICE_USER_QUERIES=30
# POLICE_AGENCY_QUERIES=300
# POLICE_RATE_WINDOW_S=60
# POLICE_LIVE_WINDOW_S=30
# POLICE_AT_WINDOW_S=60
# POLICE_HISTORY_MAX_AGE_S=7776000
# POLICE_MAX_BBOX_DEG=1
# POLICE_MAX_AIRCRAFT=200
# POLICE_MAX_POSITIONS=60
# POLICE_MAX_FLEET=200
# POLICE_WRITE_TIMEOUT_S=10
# DPO_REPORT_MAX_ROWS=50000
# WP-20: the uas.gov.ge import and the registry portal
# (docs/runbooks/registry-import.md, docs/runbooks/registry-portal.md).
# The rules file is the mapping agreed with GCAA; never commit it with
# real data. The URL only under the data-sharing agreement (G-11).
# REGISTRY_IMPORT_RULES_FILE=local/registry-import-rules.json
# REGISTRY_IMPORT_URL=https://registry.example.test/export/{kind}.csv
# REGISTRY_IMPORT_TOKEN_FILE=local/registry-import.token
# REGISTRY_IMPORT_EVERY_S=86400
# REGISTRY_CHECK_PER_MIN=30
# The portal is off until GCAA decides the registry of record (spec Q4,
# Q-A11); these are the spec's defaults, pending GCAA:
#   openssl rand -base64 32 > local/registry-portal.key
# REGISTRY_APPLICATIONS=off
# REGISTRY_OPERATOR_REPORTS=off
# REGISTRY_PORTAL_KEY_FILE=local/registry-portal.key
# REGISTRY_PORTAL_URL=https://authority.example.test/registry
# REGISTRY_MAIL_SMTP_ADDR=smtp.example.test:587
# REGISTRY_MAIL_FROM=registry@example.test
# REGISTRY_APPLICATIONS_RETAIN_S=7776000
# REGISTRY_ISSUE_PREFIX=GEO
# REGISTRY_ISSUE_RANDOM_LEN=12
