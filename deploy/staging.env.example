# uspace-authority settings for staging (AUTHORITY_ENV_FILE of
# deploy/compose.yaml). Copy it outside the repository, next to the
# deployment's other files (uspace-deploy: env/authority.env), and fill
# it in. No secret and no database URL belongs here: those come from
# AUTHORITY_SECRETS_DIR (deploy/gen-secrets.sh), and `make check-deploy`
# fails when a DSN reaches a process that does not open that database.
#
# Every variable each process reads, with its default, is in
# deploy/env/<process>.env.example (generated from `--help`, verified in
# CI). This file sets only what staging needs to differ from those
# defaults, and repeats the national choices GCAA has not answered so
# that they are visible where they are configured.
#
# ${AUTHORITY_HOST} and the peers' hosts are interpolated by docker
# compose from the deployment's environment (deploy/staging/hosts.env
# on the droplet).
#
# Set by deploy/compose.yaml, not here (the compose value wins):
#   ADMIN_ADDR, API_ADDR, RID_INGEST_ADDR, DP_ADDR, PICTURE_ADDR,
#   AUTHORITY_PUBLIC_URL, AUTHORITY_TRUSTED_PROXIES, PICTURE_SESSION_URL,
#   the *_KEY_FILE paths, BOOTSTRAP_ADMIN_PASSWORD_FILE, EVIDENCE_DIR,
#   ARCHIVE_URL, GOMEMLIMIT, SSL_CERT_FILE, WEB_API_INTERNAL_URL,
#   WEB_TRUSTED_PROXY_HOPS.

LOG_LEVEL=info
STATUS_INTERVAL_S=60

# Accepted token audiences: the public host and the lab alias.
AUTHORITY_AUDIENCES=${AUTHORITY_HOST},authority
# Staging and the lab only (M25, Q-A19); production is `required`. Every
# process that reads it says `off` at error level on every status line.
AUTHORITY_MTLS_MODE=off

# The first admin, created at the first start on an empty users table
# (the password is AUTHORITY_SECRETS_DIR/keys/admin.pw). Remove this line
# after the first sign-in (docs/runbooks/staging.md).
BOOTSTRAP_ADMIN_USERNAME=admin

# Peers. Unset, each is reported unconfigured on the status line and in
# /readyz; nothing is called.
CISP_ISSUER_URL=https://${CISP_HOST}
CISP_JWKS_URL=https://${CISP_HOST}/.well-known/jwks.json
CISP_BASE_URL=https://${CISP_HOST}
CISP_CLIENT_ID=authority-01
CIS_CALLBACK_URL=https://${AUTHORITY_HOST}/v1/cis/notifications
ANSP_ISSUER_URL=https://${ANSP_HOST}
ANSP_JWKS_URL=https://${ANSP_HOST}/.well-known/jwks.json
ANSP_BASE_URL=https://${ANSP_HOST}
DSS_BASE_URL=https://${LAB_HOST}
# authority-01's secret at this issuer, created after the first deploy
# (POST /v1/oauth/clients) and written to keys/authority-01.secret.
# Until it exists every outbound call is refused locally and counted.
# CISP_CLIENT_SECRET_FILE=/run/secrets/authority/authority-01.secret
# DP_CLIENT_SECRET_FILE=/run/secrets/authority/authority-01.secret
# MANNED_CLIENT_SECRET_FILE=/run/secrets/authority/authority-01.secret
# RECORDS_CLIENT_SECRET_FILE=/run/secrets/authority/authority-01.secret
# DETECT_CLIENT_SECRET_FILE=/run/secrets/authority/authority-01.secret

# The provider named in every ED-318 export and publication.
ZONES_PROVIDER_NAME=Staging authority
ZONES_PROVIDER_LANG=en-GB

# One detect instance owns every cell (staging runs one).
CELLS=all

# Ground (deploy/fetch-ground.sh into AUTHORITY_GROUND_DIR, mounted at
# /srv/ground). The geoid is pinned by SHA-256. Terrain tiles: unset,
# AGL limits are not judged and the height limit is not evaluated, said
# at start and on every status line.
GEOID_FILE=/srv/ground/egm2008-2_5.pgm
# GROUND_DIR=/srv/ground/tiles

# ---- National choices pending GCAA -----------------------------------------
# GCAA has not answered these. The values are the spec's defaults, kept
# here as configuration so that the answer is a change of this file, not
# of the code. Each one is pending GCAA.
#
# Retention (spec 05 section 4, Q8), pending GCAA.
RETENTION_ONLINE_DAYS=90
RETENTION_ARCHIVE_YEARS=2
RETENTION_VIOLATIONS_YEARS=5
RETENTION_INCIDENTS=indefinite
RETENTION_AUDIT_YEARS=10
# The registry of record (spec Q4, Q-A11), pending GCAA: the portal and
# operators' occurrence links stay off.
REGISTRY_APPLICATIONS=off
REGISTRY_OPERATOR_REPORTS=off
# The police realm (spec Q8, Q-A14), pending GCAA and the DPO.
POLICE_PURPOSES=public_order,traffic_enforcement,criminal_investigation,security_threat
POLICE_PII_PURPOSES=criminal_investigation,security_threat
# The console's purposes for a registry personal-data read, pending GCAA
# and the DPO (web/, docs/runbooks/web.md).
WEB_PII_PURPOSES=registration_review,oversight_inspection,data_subject_request
WEB_POLICE_PURPOSES=public_order,traffic_enforcement,criminal_investigation,security_threat
WEB_POLICE_PII_PURPOSES=criminal_investigation,security_threat
# Occurrence reports (Reg. 376/2014): the export bound is set, not left
# to the default; a larger export is refused, never truncated.
OCCURRENCES_EXPORT_MAX_BYTES=33554432

# The console's first map view ("lng,lat" and a zoom).
WEB_MAP_CENTER=44.83,41.72
WEB_MAP_ZOOM=10
